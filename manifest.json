{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "1.1.0",
  "description": "__MSG_extensionDescription__",
  "homepage_url": "https://github.com/hilarycheng/HistoryControl",
  "default_locale": "en",
  "permissions": [
    "history",
    "storage",
    "tabs",
    "menus"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_title": "__MSG_toolbarDefault__",
    "default_icon": "icons/unsaved.svg",
    "default_popup": "popup.html"
  },
  "icons": {
    "48": "icons/app-48.png",
    "96": "icons/app-96.png",
    "128": "icons/app-128.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "firefox-minimal-history@local-extension.example",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
